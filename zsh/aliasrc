# fuzzy-jump to a project dir; no-op when fzf is cancelled
function ff() {
  local dir
  dir=$(find "$PROJECTS_DIR" "$DOTFILES_DIR" "$WORK_DIR" "$PERSO_DIR" -mindepth 1 -maxdepth 1 -type d | fzf) && cd "$dir"
}

