[core]
	editor = nvim
	excludesFile = ~/.gitignore
	fsmonitor = true
	untrackedCache = true
[init]
	defaultBranch = main

[color]
	ui = auto

[alias]
  co = checkout
  br = branch
  ci = commit
  st = status
  hot = "!git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20"
  who = shortlog -sn --no-merges
  cluster = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
  fire = "!git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback'"



[pull]
	rebase = true

[fetch]
	prune = true

[rerere]
  # Activate recording of resolved conflicts
  enabled = true

[column]
    # better display branches
    ui = auto

[branch]
    # show branch with last commit first
	sort = -committerdate

# git maintenance start
# cleanup stuff with cron in background, faster repo
[maintenance]
    auto = false
    strategy = incremental

[includeIf "gitdir:~/workspace/"] # job needs, like workspace/* so all included projects
    path = .gitconfig-work

[includeIf "gitdir:~/personal/"] # perso needs, like personal/* so all included projects
    path = .gitconfig-perso

[push]
	default = current


# delta git config 
[include] 
  path = delta.gitconfig
[commit]
	gpgsign = true
